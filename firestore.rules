rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default-deny all unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'godfreedonald57@gmail.com';
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'bio', 'role', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 320))
        && data.role in ['author', 'reader']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuthorSubscription(data) {
      return data.keys().hasAll([
          'uid', 'penName', 'status', 'monthlyFeeUsd', 'recipientAccount',
          'paidUntilMs', 'autoRenew', 'preferredMethod', 'lastPaymentId',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'penName', 'status', 'monthlyFeeUsd', 'recipientAccount',
          'paidUntilMs', 'autoRenew', 'preferredMethod', 'lastPaymentId',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.penName is string && data.penName.size() >= 2 && data.penName.size() <= 80
        && data.status in ['active', 'expired']
        && data.monthlyFeeUsd == 1
        && data.recipientAccount == '4638330011712851'
        && data.paidUntilMs is int && data.paidUntilMs > 0
        && data.autoRenew is bool
        && data.preferredMethod in ['bank_transfer', 'card', 'digital_wallet', 'mobile_money']
        && isValidId(data.lastPaymentId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuthorSubscriptionPayment(data) {
      return data.keys().hasAll([
          'id', 'authorId', 'amountUsd', 'billingMonths', 'method',
          'recipientAccount', 'validUntilMs', 'paidAt'
        ])
        && data.keys().hasOnly([
          'id', 'authorId', 'amountUsd', 'billingMonths', 'method',
          'recipientAccount', 'validUntilMs', 'stripePaymentIntentId', 'paidAt'
        ])
        && isValidId(data.id)
        && isValidId(data.authorId)
        && data.authorId == request.auth.uid
        && data.amountUsd == 1
        && data.billingMonths == 1
        && data.method in ['bank_transfer', 'card', 'digital_wallet', 'mobile_money']
        && data.recipientAccount == '4638330011712851'
        && data.validUntilMs is int && data.validUntilMs > 0
        && (!('stripePaymentIntentId' in data) || isValidId(data.stripePaymentIntentId))
        && data.paidAt is timestamp;
    }

    function authorCanPublish(uid) {
      let subPath = /databases/$(database)/documents/authorSubscriptions/$(uid);
      return exists(subPath)
        && get(subPath).data.status == 'active'
        && get(subPath).data.monthlyFeeUsd == 1
        && get(subPath).data.recipientAccount == '4638330011712851'
        && get(subPath).data.paidUntilMs > request.time.toMillis();
    }

    function isValidBook(data) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorPenName', 'authorBio', 'title',
          'genre', 'format', 'pageCount', 'pitch', 'excerptTitle', 'excerptText',
          'coverImageUrl', 'coverTone', 'goalUsd', 'raisedUsd', 'donorCount',
          'editingCostUsd', 'designCostUsd', 'printingCostUsd',
          'ratingSum', 'ratingCount', 'averageRating',
          'visibility', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'authorId', 'authorPenName', 'authorBio', 'title', 'subtitle',
          'genre', 'format', 'pageCount', 'pitch', 'excerptTitle', 'excerptText',
          'coverImageUrl', 'coverTone', 'goalUsd', 'raisedUsd', 'donorCount',
          'editingCostUsd', 'designCostUsd', 'printingCostUsd',
          'ratingSum', 'ratingCount', 'averageRating',
          'lastDonationId', 'lastRatingId', 'visibility', 'status', 'isShowcase',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.authorId)
        && data.authorPenName is string && data.authorPenName.size() >= 2 && data.authorPenName.size() <= 80
        && data.authorBio is string && data.authorBio.size() >= 10 && data.authorBio.size() <= 320
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 140))
        && data.genre in [
          'Literary Fiction',
          'Sci-Fi & Fantasy',
          'Memoir & Essays',
          'Poetry',
          'Mystery & Thriller',
          'Non-Fiction'
        ]
        && data.format in [
          'Paperback & eBook',
          'Hardcover Edition',
          'Illustrated Monograph',
          'Audiobook & Print'
        ]
        && data.pageCount is int && data.pageCount >= 10 && data.pageCount <= 2000
        && data.pitch is string && data.pitch.size() >= 10 && data.pitch.size() <= 280
        && data.excerptTitle is string && data.excerptTitle.size() >= 2 && data.excerptTitle.size() <= 120
        && data.excerptText is string && data.excerptText.size() >= 80 && data.excerptText.size() <= 8000
        && data.coverImageUrl is string && data.coverImageUrl.size() >= 4 && data.coverImageUrl.size() <= 600
        && data.coverTone in ['cobalt', 'sage', 'charcoal', 'alabaster']
        && data.goalUsd is number && data.goalUsd >= 50 && data.goalUsd <= 100000
        && data.raisedUsd is number && data.raisedUsd >= 0 && data.raisedUsd <= 1000000
        && data.donorCount is int && data.donorCount >= 0 && data.donorCount <= 100000
        && data.editingCostUsd is number && data.editingCostUsd >= 0 && data.editingCostUsd <= 100000
        && data.designCostUsd is number && data.designCostUsd >= 0 && data.designCostUsd <= 100000
        && data.printingCostUsd is number && data.printingCostUsd >= 0 && data.printingCostUsd <= 100000
        && data.ratingSum is int && data.ratingSum >= 0 && data.ratingSum <= 5000000
        && data.ratingCount is int && data.ratingCount >= 0 && data.ratingCount <= 1000000
        && data.averageRating is number && data.averageRating >= 0 && data.averageRating <= 5
        && (!('lastDonationId' in data) || isValidId(data.lastDonationId))
        && (!('lastRatingId' in data) || isValidId(data.lastRatingId))
        && data.visibility in ['public', 'archived']
        && data.status in ['seeking_funding', 'funded', 'published']
        && (!('isShowcase' in data) || data.isShowcase is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDonation(data) {
      return data.keys().hasAll([
          'id', 'bookId', 'bookTitle', 'authorId', 'donorId', 'donorName',
          'amountUsd', 'paymentMethod', 'visibility', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'bookId', 'bookTitle', 'authorId', 'donorId', 'donorName',
          'amountUsd', 'paymentMethod', 'message', 'stripePaymentIntentId', 'visibility', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.bookId)
        && data.bookTitle is string && data.bookTitle.size() >= 2 && data.bookTitle.size() <= 120
        && isValidId(data.authorId)
        && isValidId(data.donorId)
        && data.donorName is string && data.donorName.size() >= 1 && data.donorName.size() <= 80
        && data.amountUsd is number && data.amountUsd >= 1 && data.amountUsd <= 5000
        && data.paymentMethod in ['card', 'digital_wallet', 'bank_transfer', 'mobile_money']
        && (!('message' in data) || (data.message is string && data.message.size() <= 240))
        && (!('stripePaymentIntentId' in data) || isValidId(data.stripePaymentIntentId))
        && data.visibility == 'public'
        && data.createdAt is timestamp;
    }

    function isValidRating(data) {
      return data.keys().hasAll([
          'id', 'bookId', 'bookTitle', 'authorId', 'reviewerId', 'reviewerName',
          'stars', 'craftFocus', 'visibility', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'bookId', 'bookTitle', 'authorId', 'reviewerId', 'reviewerName',
          'stars', 'craftFocus', 'reviewText', 'visibility', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.bookId)
        && data.bookTitle is string && data.bookTitle.size() >= 2 && data.bookTitle.size() <= 120
        && isValidId(data.authorId)
        && isValidId(data.reviewerId)
        && data.reviewerName is string && data.reviewerName.size() >= 1 && data.reviewerName.size() <= 80
        && data.stars is int && data.stars >= 1 && data.stars <= 5
        && data.craftFocus in ['Storytelling', 'Prose & Voice', 'Worldbuilding', 'Pacing', 'Originality']
        && (!('reviewText' in data) || (data.reviewText is string && data.reviewText.size() <= 600))
        && data.visibility == 'public'
        && data.createdAt is timestamp;
    }

    function isValidAuthorFollow(data) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorPenName', 'followerId', 'followerName', 'visibility', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'authorId', 'authorPenName', 'followerId', 'followerName', 'visibility', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.authorId)
        && data.authorPenName is string && data.authorPenName.size() >= 2 && data.authorPenName.size() <= 80
        && isValidId(data.followerId)
        && data.followerName is string && data.followerName.size() >= 1 && data.followerName.size() <= 80
        && data.visibility == 'public'
        && data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    // Private PII User Profiles: strict owner-only (or verified admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bio', 'role', 'updatedAt']);
      allow delete: if false;
    }

    // Author $1/Month Subscription State (paid to 4638330011712851)
    match /authorSubscriptions/{authorId} {
      allow get: if isValidId(authorId) && (isOwner(authorId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isValidId(authorId)
        && isOwner(authorId)
        && isValidAuthorSubscription(incoming())
        && incoming().uid == authorId
        && incoming().uid == request.auth.uid
        && incoming().status == 'active'
        && incoming().paidUntilMs > request.time.toMillis()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !exists(/databases/$(database)/documents/authorSubscriptionPayments/$(incoming().lastPaymentId))
        && existsAfter(/databases/$(database)/documents/authorSubscriptionPayments/$(incoming().lastPaymentId))
        && getAfter(/databases/$(database)/documents/authorSubscriptionPayments/$(incoming().lastPaymentId)).data.authorId == authorId
        && getAfter(/databases/$(database)/documents/authorSubscriptionPayments/$(incoming().lastPaymentId)).data.validUntilMs == incoming().paidUntilMs;

      allow update: if isValidId(authorId)
        && isOwner(authorId)
        && isValidAuthorSubscription(incoming())
        && incoming().uid == existing().uid
        && incoming().uid == authorId
        && incoming().monthlyFeeUsd == existing().monthlyFeeUsd
        && incoming().recipientAccount == existing().recipientAccount
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Update auto-renew / pen name / preferred method
          incoming().diff(existing()).affectedKeys().hasOnly(['penName', 'autoRenew', 'preferredMethod', 'updatedAt'])
          ||
          // Action 2: Renew $1/month subscription atomically with payment ledger receipt
          (
            incoming().status == 'active'
            && incoming().paidUntilMs > existing().paidUntilMs
            && !exists(/databases/$(database)/documents/authorSubscriptionPayments/$(incoming().lastPaymentId))
            && existsAfter(/databases/$(database)/documents/authorSubscriptionPayments/$(incoming().lastPaymentId))
            && getAfter(/databases/$(database)/documents/authorSubscriptionPayments/$(incoming().lastPaymentId)).data.authorId == authorId
            && getAfter(/databases/$(database)/documents/authorSubscriptionPayments/$(incoming().lastPaymentId)).data.validUntilMs == incoming().paidUntilMs
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'paidUntilMs', 'lastPaymentId', 'preferredMethod', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    // Immutable $1/Month Author Subscription Payment Ledger (recipient 4638330011712851)
    match /authorSubscriptionPayments/{paymentId} {
      allow get: if isValidId(paymentId) && isVerifiedUser() && resource != null && (existing().authorId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isValidId(paymentId)
        && isVerifiedUser()
        && isValidAuthorSubscriptionPayment(incoming())
        && incoming().id == paymentId
        && incoming().paidAt == request.time
        && existsAfter(/databases/$(database)/documents/authorSubscriptions/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/authorSubscriptions/$(request.auth.uid)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/authorSubscriptions/$(request.auth.uid)).data.lastPaymentId == paymentId
        && getAfter(/databases/$(database)/documents/authorSubscriptions/$(request.auth.uid)).data.paidUntilMs == incoming().validUntilMs;
      allow update, delete: if false;
    }

    // Debut Author Book Campaigns
    match /books/{bookId} {
      allow get: if isValidId(bookId)
        && resource != null
        && (existing().visibility == 'public' || (isSignedIn() && existing().authorId == request.auth.uid));
      allow list: if resource.data.visibility == 'public'
        || (isSignedIn() && resource.data.authorId == request.auth.uid);

      allow create: if isValidId(bookId)
        && isVerifiedUser()
        && isValidBook(incoming())
        && incoming().id == bookId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            incoming().authorId == request.auth.uid
            && !('isShowcase' in incoming())
            && incoming().raisedUsd == 0
            && incoming().donorCount == 0
            && incoming().ratingSum == 0
            && incoming().ratingCount == 0
            && incoming().averageRating == 0
            && incoming().status == 'seeking_funding'
            && authorCanPublish(request.auth.uid)
          )
          ||
          (
            isAdmin()
            && incoming().isShowcase == true
          )
        );

      allow update: if isValidId(bookId)
        && isVerifiedUser()
        && isValidBook(incoming())
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1a: Author updates editorial & budget fields before donations or publication
          (
            existing().authorId == request.auth.uid
            && existing().status != 'published'
            && existing().donorCount == 0
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'authorPenName', 'authorBio', 'title', 'subtitle', 'genre', 'format',
              'pageCount', 'pitch', 'excerptTitle', 'excerptText', 'coverImageUrl',
              'coverTone', 'goalUsd', 'editingCostUsd', 'designCostUsd', 'printingCostUsd',
              'visibility', 'updatedAt'
            ])
          )
          ||
          // Action 1b: Author refines editorial fields (synopsis, excerpt, cover, bio) even after donations/publishing
          (
            existing().authorId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'authorPenName', 'authorBio', 'title', 'subtitle', 'genre', 'format',
              'pageCount', 'pitch', 'excerptTitle', 'excerptText', 'coverImageUrl',
              'coverTone', 'visibility', 'updatedAt'
            ])
          )
          ||
          // Action 2: Author transitions a funded book to published
          (
            existing().authorId == request.auth.uid
            && existing().status == 'funded'
            && incoming().status == 'published'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          ||
          // Action 3: Reader donates atomically with /donations/{lastDonationId}
          (
            isValidId(incoming().lastDonationId)
            && !exists(/databases/$(database)/documents/donations/$(incoming().lastDonationId))
            && existsAfter(/databases/$(database)/documents/donations/$(incoming().lastDonationId))
            && getAfter(/databases/$(database)/documents/donations/$(incoming().lastDonationId)).data.bookId == bookId
            && getAfter(/databases/$(database)/documents/donations/$(incoming().lastDonationId)).data.donorId == request.auth.uid
            && incoming().donorCount == existing().donorCount + 1
            && incoming().raisedUsd == existing().raisedUsd + getAfter(/databases/$(database)/documents/donations/$(incoming().lastDonationId)).data.amountUsd
            && (
              (incoming().raisedUsd >= existing().goalUsd && incoming().status in ['funded', 'published'])
              || (incoming().raisedUsd < existing().goalUsd && incoming().status == existing().status)
            )
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'raisedUsd', 'donorCount', 'lastDonationId', 'status', 'updatedAt'
            ])
          )
          ||
          // Action 4: Reader rates book atomically with /ratings/{lastRatingId}
          (
            existing().authorId != request.auth.uid
            && isValidId(incoming().lastRatingId)
            && incoming().lastRatingId == bookId + '_' + request.auth.uid
            && !exists(/databases/$(database)/documents/ratings/$(incoming().lastRatingId))
            && existsAfter(/databases/$(database)/documents/ratings/$(incoming().lastRatingId))
            && getAfter(/databases/$(database)/documents/ratings/$(incoming().lastRatingId)).data.bookId == bookId
            && getAfter(/databases/$(database)/documents/ratings/$(incoming().lastRatingId)).data.reviewerId == request.auth.uid
            && incoming().ratingCount == existing().ratingCount + 1
            && incoming().ratingSum == existing().ratingSum + getAfter(/databases/$(database)/documents/ratings/$(incoming().lastRatingId)).data.stars
            && incoming().averageRating * incoming().ratingCount >= incoming().ratingSum - (incoming().ratingCount * 0.05)
            && incoming().averageRating * incoming().ratingCount <= incoming().ratingSum + (incoming().ratingCount * 0.05)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'ratingSum', 'ratingCount', 'averageRating', 'lastRatingId', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(bookId)
        && isVerifiedUser()
        && existing().authorId == request.auth.uid
        && existing().donorCount == 0
        && existing().ratingCount == 0;
    }

    // Immutable Book Publishing Donations
    match /donations/{donationId} {
      allow get: if isValidId(donationId)
        && resource != null
        && (existing().visibility == 'public' || (isSignedIn() && (existing().donorId == request.auth.uid || existing().authorId == request.auth.uid)));
      allow list: if resource.data.visibility == 'public'
        || (isSignedIn() && (resource.data.donorId == request.auth.uid || resource.data.authorId == request.auth.uid));

      allow create: if isValidId(donationId)
        && isVerifiedUser()
        && isValidDonation(incoming())
        && incoming().id == donationId
        && incoming().donorId == request.auth.uid
        && incoming().visibility == 'public'
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/books/$(incoming().bookId))
        && get(/databases/$(database)/documents/books/$(incoming().bookId)).data.authorId == incoming().authorId
        && existsAfter(/databases/$(database)/documents/books/$(incoming().bookId))
        && getAfter(/databases/$(database)/documents/books/$(incoming().bookId)).data.lastDonationId == donationId;

      allow update, delete: if false;
    }

    // Immutable 1-5 Star Reader Ratings (1 per reviewer per book)
    match /ratings/{ratingId} {
      allow get: if isValidId(ratingId)
        && resource != null
        && (existing().visibility == 'public' || (isSignedIn() && (existing().reviewerId == request.auth.uid || existing().authorId == request.auth.uid)));
      allow list: if resource.data.visibility == 'public'
        || (isSignedIn() && (resource.data.reviewerId == request.auth.uid || resource.data.authorId == request.auth.uid));

      allow create: if isValidId(ratingId)
        && isVerifiedUser()
        && isValidRating(incoming())
        && incoming().id == ratingId
        && incoming().reviewerId == request.auth.uid
        && ratingId == incoming().bookId + '_' + request.auth.uid
        && incoming().visibility == 'public'
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/books/$(incoming().bookId))
        && get(/databases/$(database)/documents/books/$(incoming().bookId)).data.authorId == incoming().authorId
        && get(/databases/$(database)/documents/books/$(incoming().bookId)).data.authorId != request.auth.uid
        && existsAfter(/databases/$(database)/documents/books/$(incoming().bookId))
        && getAfter(/databases/$(database)/documents/books/$(incoming().bookId)).data.lastRatingId == ratingId;

      allow update, delete: if false;
    }

    // Public Author Follow Records (1 per follower per author)
    match /authorFollows/{followId} {
      allow get: if isValidId(followId)
        && resource != null
        && (existing().visibility == 'public' || (isSignedIn() && existing().followerId == request.auth.uid));
      allow list: if resource.data.visibility == 'public'
        || (isSignedIn() && resource.data.followerId == request.auth.uid);

      allow create: if isValidId(followId)
        && isVerifiedUser()
        && isValidAuthorFollow(incoming())
        && incoming().id == followId
        && incoming().followerId == request.auth.uid
        && incoming().authorId != request.auth.uid
        && followId == incoming().authorId + '_' + request.auth.uid
        && incoming().visibility == 'public'
        && incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isValidId(followId)
        && isVerifiedUser()
        && existing().followerId == request.auth.uid;
    }
  }
}
