  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private PII user profiles strictly scoped to the owner or verified admin."
    },
    "/authorSubscriptions/{authorId}": {
      "schema": "AuthorSubscription",
      "description": "Author $1/month publishing subscription state paid to 4638330011712851."
    },
    "/authorSubscriptionPayments/{paymentId}": {
      "schema": "AuthorSubscriptionPayment",
      "description": "Immutable $1/month author subscription receipts paid to 4638330011712851."
    },
    "/books/{bookId}": {
      "schema": "BookCampaign",
      "description": "Debut author book campaigns with excerpts, publishing goals, live donation totals, and aggregate star ratings."
    },
    "/donations/{donationId}": {
      "schema": "BookDonation",
      "description": "Immutable reader donation receipts atomically linked to book funding totals."
    },
    "/ratings/{ratingId}": {
      "schema": "BookRating",
      "description": "Immutable 1-5 star reader ratings and reviews atomically linked to book aggregate ratings."
    },
    "/authorFollows/{followId}": {
      "schema": "AuthorFollow",
      "description": "Public reader follow records keyed {authorId}_{followerId}."
    }
  }
}
