{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated user profile storing PII and author/reader account metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "bio": {
          "type": "string",
          "maxLength": 320
        },
        "role": {
          "type": "string",
          "enum": ["author", "reader"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "role", "createdAt", "updatedAt"]
    },
    "AuthorSubscription": {
      "title": "AuthorSubscription",
      "description": "Active $1/month author publishing subscription paid to recipient account 4638330011712851.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "penName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["active", "expired"]
        },
        "monthlyFeeUsd": {
          "type": "integer"
        },
        "recipientAccount": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^4638330011712851$"
        },
        "paidUntilMs": {
          "type": "integer"
        },
        "autoRenew": {
          "type": "boolean"
        },
        "preferredMethod": {
          "type": "string",
          "enum": ["bank_transfer", "card", "digital_wallet", "mobile_money"]
        },
        "lastPaymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "penName",
        "status",
        "monthlyFeeUsd",
        "recipientAccount",
        "paidUntilMs",
        "autoRenew",
        "preferredMethod",
        "lastPaymentId",
        "createdAt",
        "updatedAt"
      ]
    },
    "AuthorSubscriptionPayment": {
      "title": "AuthorSubscriptionPayment",
      "description": "Immutable $1/month author subscription payment receipt sent to account 4638330011712851.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "amountUsd": {
          "type": "integer"
        },
        "billingMonths": {
          "type": "integer"
        },
        "method": {
          "type": "string",
          "enum": ["bank_transfer", "card", "digital_wallet", "mobile_money"]
        },
        "recipientAccount": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^4638330011712851$"
        },
        "validUntilMs": {
          "type": "integer"
        },
        "stripePaymentIntentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "paidAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "authorId",
        "amountUsd",
        "billingMonths",
        "method",
        "recipientAccount",
        "validUntilMs",
        "paidAt"
      ]
    },
    "BookCampaign": {
      "title": "BookCampaign",
      "description": "Debut author book listing with sample chapter excerpt, publishing cost breakdown, reader donation progress, and aggregate community ratings.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorPenName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "authorBio": {
          "type": "string",
          "minLength": 10,
          "maxLength": 320
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "subtitle": {
          "type": "string",
          "maxLength": 140
        },
        "genre": {
          "type": "string",
          "enum": [
            "Literary Fiction",
            "Sci-Fi & Fantasy",
            "Memoir & Essays",
            "Poetry",
            "Mystery & Thriller",
            "Non-Fiction"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "Paperback & eBook",
            "Hardcover Edition",
            "Illustrated Monograph",
            "Audiobook & Print"
          ]
        },
        "pageCount": {
          "type": "integer"
        },
        "pitch": {
          "type": "string",
          "minLength": 10,
          "maxLength": 280
        },
        "excerptTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "excerptText": {
          "type": "string",
          "minLength": 80,
          "maxLength": 8000
        },
        "coverImageUrl": {
          "type": "string",
          "minLength": 4,
          "maxLength": 600
        },
        "coverTone": {
          "type": "string",
          "enum": ["cobalt", "sage", "charcoal", "alabaster"]
        },
        "goalUsd": {
          "type": "number"
        },
        "raisedUsd": {
          "type": "number"
        },
        "donorCount": {
          "type": "integer"
        },
        "editingCostUsd": {
          "type": "number"
        },
        "designCostUsd": {
          "type": "number"
        },
        "printingCostUsd": {
          "type": "number"
        },
        "ratingSum": {
          "type": "integer"
        },
        "ratingCount": {
          "type": "integer"
        },
        "averageRating": {
          "type": "number"
        },
        "lastDonationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lastRatingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "archived"]
        },
        "status": {
          "type": "string",
          "enum": ["seeking_funding", "funded", "published"]
        },
        "isShowcase": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "authorId",
        "authorPenName",
        "authorBio",
        "title",
        "genre",
        "format",
        "pageCount",
        "pitch",
        "excerptTitle",
        "excerptText",
        "coverImageUrl",
        "coverTone",
        "goalUsd",
        "raisedUsd",
        "donorCount",
        "editingCostUsd",
        "designCostUsd",
        "printingCostUsd",
        "ratingSum",
        "ratingCount",
        "averageRating",
        "visibility",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookDonation": {
      "title": "BookDonation",
