    "AuthorFollow": {
      "title": "AuthorFollow",
      "description": "Public reader follow record for a debut author, keyed deterministically one per follower per author.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
