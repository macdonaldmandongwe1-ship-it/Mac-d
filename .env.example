# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Server-side API key for real author email delivery via Resend.
# Configure this in AI Studio Settings -> Secrets (never expose to client code).
RESEND_API_KEY=

# RESEND_FROM_EMAIL: Verified sender identity for transactional author emails.
# Example: "FirstFolio <notifications@yourdomain.com>"
RESEND_FROM_EMAIL=

# STRIPE_SECRET_KEY: Server-side Stripe secret key (sk_test_... or sk_live_...).
# Configure in AI Studio Settings -> Secrets (never expose to client code).
STRIPE_SECRET_KEY=

# STRIPE_PUBLISHABLE_KEY: Stripe publishable key (pk_test_... or pk_live_...).
# Safe for browser Stripe Elements initialization via /api/stripe/config.
STRIPE_PUBLISHABLE_KEY=

# STRIPE_WEBHOOK_SECRET: Optional Stripe webhook signing secret (whsec_...) for /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
